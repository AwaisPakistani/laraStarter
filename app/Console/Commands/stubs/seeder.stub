<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use App\Models\{{ModelName}};
use App\Models\Permission;
class {{ModelName}}Seeder extends Seeder
{
    public function run()
    {
        // 1. Define CRUD permissions
        $permissions = [
            '{{pluralLower}}.index',
            '{{pluralLower}}.create',
            '{{pluralLower}}.store',
            '{{pluralLower}}.edit',
            '{{pluralLower}}.update',
            '{{pluralLower}}.show',
            '{{pluralLower}}.destroy',
            '{{pluralLower}}.toggleStatus',
        ];
        $createdPermissions = [];

        foreach ($permissions as $permission) {
            $createdPermissions[] = Permission::firstOrCreate([
                'name' => $permission,
                'guard_name' => 'web'
            ]);
        }

        // Find or create the super_admin role and assign the permissions
        $role = Role::firstOrCreate(['email' => 'superadmin@gmail.com', 'guard_name' => 'web']);
        $role->givePermissionTo($createdPermissions);
        //{{ModelName}}::factory()->count(10)->create();
    }
}
